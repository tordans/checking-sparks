# Test image for the API: PHP 8.5 CLI + Composer + the extensions the app needs.
# Build:  docker build -t checking-sparks-api-test -f api/Dockerfile.test api
FROM php:8.5-cli

RUN apt-get update \
 && apt-get install -y --no-install-recommends git unzip libzip-dev libgmp-dev \
 && docker-php-ext-install pdo_mysql zip gmp \
 && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /app
